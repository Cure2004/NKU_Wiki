{
  "extends": "@tsconfig/node24/tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@/*": [
        "./docs/.vitepress/*"
      ]
    }
  },
  "vueCompilerOptions": {
    "vitePressExtensions": [
      ".md"
    ]
  },
  "include": [
    "**/.*.md",
    "**/*.md",
    "**/.vitepress/**/*.ts"
  ]
}